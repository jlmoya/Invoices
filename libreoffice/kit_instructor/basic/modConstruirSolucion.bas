Option Explicit
Option VBASupport 1

' SOLO INSTRUCTOR. Ejecutar en un .odb nuevo y vacío creado con HSQLDB incorporado.
' Nunca elimina objetos existentes: una segunda ejecución se rechaza.
' HSQLDB confirma cada CREATE al instante; solo la carga de datos es una transacción.
' Si el constructor falla, crea otro .odb vacío y vuelve a ejecutarlo.
' Sin START WITH 1, una identidad de HSQLDB 1.8 empieza en 0.
' Tras insertar Id explícitos, HSQLDB continúa cada identidad en el máximo más uno.
Public Function ConstruirSolucion(Optional ByVal conexion As Variant, _
                                 Optional ByVal documento As Variant, _
                                 Optional ByVal mostrar As Boolean = True) As String
    Dim cn As Object, doc As Object, q As Object, rs As Object, defs As Object
    Dim consulta As Object, transaccion As Boolean, codigo As Long, descripcionError As String
    cn = ConexionBase(conexion)
    If IsMissing(documento) Then
        doc = ThisDatabaseDocument
    Else
        doc = documento
    End If
    defs = doc.DataSource.QueryDefinitions
    q = cn.createStatement()
    rs = q.executeQuery("SELECT COUNT(*) FROM INFORMATION_SCHEMA.SYSTEM_TABLES WHERE TABLE_SCHEM='PUBLIC'")
    rs.next()
    If rs.getInt(1) <> 0 Or defs.hasElements() Then
        rs.close(): q.close()
        Err.Raise 7001, "Curso", MensajeError(7001)
    End If
    rs.close(): q.close()
    If Not cn.getAutoCommit() Then Err.Raise 3002, "Curso", MensajeError(3002)
    On Error GoTo Falla
    CrearTablas cn
    cn.setAutoCommit(False)
    transaccion = True
    CargarDatos cn
    cn.commit()
    transaccion = False
    cn.setAutoCommit(True)
    CrearConsultas cn
    ' Un parámetro de Base no pertenece al DDL de una vista: va en una consulta de Base.
    consulta = defs.createInstance()
    consulta.Command = "SELECT ""NumeroFactura"",""Fecha"",""RazonSocial"",""Total"" FROM ""qryTotalesFactura"" WHERE ""Fecha"" BETWEEN :FechaInicial AND :FechaFinal ORDER BY ""Fecha"""
    consulta.EscapeProcessing = True
    defs.insertByName("qryFacturasPorPeriodo",consulta)
    doc.store()
    ConstruirSolucion = "Base construida: 7 tablas, 6 relaciones, 10 vistas y 1 consulta con parámetros."
    If mostrar Then MsgBox ConstruirSolucion,64,"ConstruirSolucion"
    Exit Function
Falla:
    codigo = Err.Number
    descripcionError = Err.Description & " Crea un .odb nuevo y vacío antes de repetir."
    On Error Resume Next
    If transaccion Then cn.rollback()
    cn.setAutoCommit(True): q.close()
    On Error GoTo 0
    Err.Raise codigo, "Curso", descripcionError
End Function

' HSQLDB 1.8 solo acepta CHECK, UNIQUE y FOREIGN KEY como restricciones de tabla.
' El correo no lleva CHECK: dentro de un CHECK, LIKE rechaza todo valor y POSITION
' impide reabrir la base. El formato del correo se valida fuera del motor.
Private Sub CrearTablas(ByVal cn As Object)
    EjecutarSQL cn,"CREATE TABLE ""tblClientes"" (""IdCliente"" INTEGER GENERATED BY DEFAULT AS IDENTITY (START WITH 1) NOT NULL,""DocumentoFiscal"" VARCHAR(20) NOT NULL,""RazonSocial"" VARCHAR(100) NOT NULL,""Direccion"" VARCHAR(150),""Ciudad"" VARCHAR(60),""Telefono"" VARCHAR(20),""Correo"" VARCHAR(100),""FechaAlta"" DATE DEFAULT CURRENT_DATE,CONSTRAINT ""pkClientes"" PRIMARY KEY (""IdCliente""),CONSTRAINT ""uxClientesDocumento"" UNIQUE (""DocumentoFiscal""))"
    EjecutarSQL cn,"CREATE TABLE ""tblCategorias"" (""IdCategoria"" INTEGER NOT NULL,""Nombre"" VARCHAR(50) NOT NULL,""IdCategoriaPadre"" INTEGER,CONSTRAINT ""pkCategorias"" PRIMARY KEY (""IdCategoria""),CONSTRAINT ""uxCategoriasNombre"" UNIQUE (""Nombre""),CONSTRAINT ""relCategoriaPadre"" FOREIGN KEY (""IdCategoriaPadre"") REFERENCES ""tblCategorias"" (""IdCategoria""))"
    EjecutarSQL cn,"CREATE TABLE ""tblProductos"" (""IdProducto"" INTEGER GENERATED BY DEFAULT AS IDENTITY (START WITH 1) NOT NULL,""Codigo"" VARCHAR(15) NOT NULL,""Descripcion"" VARCHAR(100) NOT NULL,""IdCategoria"" INTEGER NOT NULL,""Precio"" DECIMAL(18,4) NOT NULL,""Existencia"" INTEGER DEFAULT 0,""Activo"" BOOLEAN DEFAULT TRUE,CONSTRAINT ""pkProductos"" PRIMARY KEY (""IdProducto""),CONSTRAINT ""uxProductosCodigo"" UNIQUE (""Codigo""),CONSTRAINT ""ckProductosPrecio"" CHECK (""Precio"">=0),CONSTRAINT ""ckProductosExistencia"" CHECK (""Existencia"">=0),CONSTRAINT ""relProductoCategoria"" FOREIGN KEY (""IdCategoria"") REFERENCES ""tblCategorias"" (""IdCategoria""))"
    EjecutarSQL cn,"CREATE TABLE ""tblFacturas"" (""IdFactura"" INTEGER GENERATED BY DEFAULT AS IDENTITY (START WITH 1) NOT NULL,""NumeroFactura"" INTEGER,""Fecha"" DATE DEFAULT CURRENT_DATE NOT NULL,""IdCliente"" INTEGER NOT NULL,""TasaImpuesto"" DECIMAL(9,4) DEFAULT 0.16 NOT NULL,""Estado"" VARCHAR(10) DEFAULT 'Borrador' NOT NULL,""Observaciones"" LONGVARCHAR,CONSTRAINT ""pkFacturas"" PRIMARY KEY (""IdFactura""),CONSTRAINT ""uxFacturasNumero"" UNIQUE (""NumeroFactura""),CONSTRAINT ""ckFacturasNumero"" CHECK (""NumeroFactura"">0),CONSTRAINT ""ckFacturasTasa"" CHECK (""TasaImpuesto"" BETWEEN 0 AND 1),CONSTRAINT ""ckFacturasEstado"" CHECK (""Estado"" IN ('Borrador','Emitida','Pagada','Anulada')),CONSTRAINT ""relFacturaCliente"" FOREIGN KEY (""IdCliente"") REFERENCES ""tblClientes"" (""IdCliente""))"
    EjecutarSQL cn,"CREATE TABLE ""tblDetalleFactura"" (""IdFactura"" INTEGER NOT NULL,""IdProducto"" INTEGER NOT NULL,""Cantidad"" INTEGER DEFAULT 1 NOT NULL,""PrecioUnitario"" DECIMAL(18,4) NOT NULL,CONSTRAINT ""pkDetalleFactura"" PRIMARY KEY (""IdFactura"",""IdProducto""),CONSTRAINT ""ckDetalleCantidad"" CHECK (""Cantidad"">0),CONSTRAINT ""ckDetallePrecio"" CHECK (""PrecioUnitario"">=0),CONSTRAINT ""relDetalleFactura"" FOREIGN KEY (""IdFactura"") REFERENCES ""tblFacturas"" (""IdFactura"") ON DELETE CASCADE,CONSTRAINT ""relDetalleProducto"" FOREIGN KEY (""IdProducto"") REFERENCES ""tblProductos"" (""IdProducto""))"
    EjecutarSQL cn,"CREATE TABLE ""tblHistorialPrecios"" (""IdCambio"" INTEGER GENERATED BY DEFAULT AS IDENTITY (START WITH 1) NOT NULL,""IdProducto"" INTEGER NOT NULL,""PrecioAnterior"" DECIMAL(18,4) NOT NULL,""FechaCambio"" TIMESTAMP DEFAULT CURRENT_TIMESTAMP NOT NULL,CONSTRAINT ""pkHistorialPrecios"" PRIMARY KEY (""IdCambio""),CONSTRAINT ""ckHistorialPrecio"" CHECK (""PrecioAnterior"">=0),CONSTRAINT ""relHistorialProducto"" FOREIGN KEY (""IdProducto"") REFERENCES ""tblProductos"" (""IdProducto""))"
    EjecutarSQL cn,"CREATE TABLE ""tblParametros"" (""Id"" INTEGER NOT NULL,""NombreEmpresa"" VARCHAR(100),""DocumentoFiscalEmpresa"" VARCHAR(20),""TasaImpuesto"" DECIMAL(9,4) NOT NULL,CONSTRAINT ""pkParametros"" PRIMARY KEY (""Id""),CONSTRAINT ""ckParametrosId"" CHECK (""Id""=1),CONSTRAINT ""ckParametrosTasa"" CHECK (""TasaImpuesto"" BETWEEN 0 AND 1))"
End Sub

