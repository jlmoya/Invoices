' El impuesto se redondea a centavos con mitades hacia arriba: FLOOR(x * 100 + 0.5) / 100.
' ROUND de HSQLDB calcula en coma flotante binaria y falla en empates como 2.405.
Private Sub CrearConsultas(ByVal cn As Object)
    EjecutarSQL cn,"CREATE VIEW ""qryLineasConImporte"" AS SELECT d.""IdFactura"",d.""IdProducto"",p.""Codigo"",p.""Descripcion"",d.""Cantidad"",d.""PrecioUnitario"",CAST(d.""Cantidad""*d.""PrecioUnitario"" AS DECIMAL(18,4)) AS ""Importe"" FROM ""tblDetalleFactura"" d INNER JOIN ""tblProductos"" p ON d.""IdProducto""=p.""IdProducto"""
    EjecutarSQL cn,"CREATE VIEW ""qrySubtotalesFactura"" AS SELECT ""IdFactura"",SUM(""Importe"") AS ""Subtotal"" FROM ""qryLineasConImporte"" GROUP BY ""IdFactura"""
    EjecutarSQL cn,"CREATE VIEW ""qryTotalesFactura"" AS SELECT f.""IdFactura"",f.""NumeroFactura"",f.""Fecha"",f.""Estado"",c.""RazonSocial"",s.""Subtotal"",f.""TasaImpuesto"",CAST(FLOOR(s.""Subtotal""*f.""TasaImpuesto""*100+0.5)/100 AS DECIMAL(18,4)) AS ""Impuesto"",s.""Subtotal""+CAST(FLOOR(s.""Subtotal""*f.""TasaImpuesto""*100+0.5)/100 AS DECIMAL(18,4)) AS ""Total"" FROM ""tblClientes"" c INNER JOIN ""tblFacturas"" f ON c.""IdCliente""=f.""IdCliente"" INNER JOIN ""qrySubtotalesFactura"" s ON f.""IdFactura""=s.""IdFactura"""
    EjecutarSQL cn,"CREATE VIEW ""qryVentasPorCliente"" AS SELECT ""RazonSocial"",COUNT(*) AS ""Facturas"",SUM(""Total"") AS ""TotalVendido"" FROM ""qryTotalesFactura"" WHERE ""Estado"" IN ('Emitida','Pagada') GROUP BY ""RazonSocial"""
    EjecutarSQL cn,"CREATE VIEW ""qryFacturaImpresion"" AS SELECT p.""NombreEmpresa"",p.""DocumentoFiscalEmpresa"",t.""IdFactura"",t.""NumeroFactura"",t.""Fecha"",t.""Estado"",t.""RazonSocial"",c.""DocumentoFiscal"",c.""Direccion"",c.""Ciudad"",l.""Codigo"",l.""Descripcion"",l.""Cantidad"",l.""PrecioUnitario"",l.""Importe"",t.""Subtotal"",t.""TasaImpuesto"",t.""Impuesto"",t.""Total"" FROM ""tblParametros"" p CROSS JOIN ""qryTotalesFactura"" t INNER JOIN ""tblFacturas"" f ON t.""IdFactura""=f.""IdFactura"" INNER JOIN ""tblClientes"" c ON f.""IdCliente""=c.""IdCliente"" INNER JOIN ""qryLineasConImporte"" l ON t.""IdFactura""=l.""IdFactura"""
    EjecutarSQL cn,"CREATE VIEW ""qryColaCobranza"" AS SELECT ""NumeroFactura"",""Fecha"",""RazonSocial"",""Total"" FROM ""qryTotalesFactura"" WHERE ""Estado""='Emitida'"
    EjecutarSQL cn,"CREATE VIEW ""qryCategoriasHoja"" AS SELECT c.""IdCategoria"",c.""Nombre"" FROM ""tblCategorias"" c LEFT JOIN ""tblCategorias"" h ON c.""IdCategoria""=h.""IdCategoriaPadre"" WHERE h.""IdCategoria"" IS NULL"
    EjecutarSQL cn,"CREATE VIEW ""qryProductosConPadre"" AS SELECT p.""Codigo"",p.""Descripcion"",COALESCE(m.""Nombre"" || ' > ','') || c.""Nombre"" AS ""Ruta"" FROM ""tblProductos"" p INNER JOIN ""tblCategorias"" c ON p.""IdCategoria""=c.""IdCategoria"" LEFT JOIN ""tblCategorias"" m ON c.""IdCategoriaPadre""=m.""IdCategoria"""
    EjecutarSQL cn,"CREATE VIEW ""qryVentasPorProducto"" AS SELECT l.""Codigo"",l.""Descripcion"",SUM(l.""Cantidad"") AS ""Unidades"",SUM(l.""Importe"") AS ""Monto"" FROM ""qryLineasConImporte"" l INNER JOIN ""tblFacturas"" f ON l.""IdFactura""=f.""IdFactura"" WHERE f.""Estado"" IN ('Emitida','Pagada') GROUP BY l.""Codigo"",l.""Descripcion"""
    EjecutarSQL cn,"CREATE VIEW ""qryVentasPorMes"" AS SELECT EXTRACT(YEAR FROM ""Fecha"") AS ""Anio"",EXTRACT(MONTH FROM ""Fecha"") AS ""Mes"",COUNT(*) AS ""Facturas"",SUM(""Total"") AS ""TotalFacturado"" FROM ""qryTotalesFactura"" WHERE ""Estado"" IN ('Emitida','Pagada') GROUP BY EXTRACT(YEAR FROM ""Fecha""),EXTRACT(MONTH FROM ""Fecha"")"
End Sub

Public Sub EjecutarConstructor()
    Dim resultado As String
    resultado = ConstruirSolucion()
End Sub

' Base invalida el statement al actualizar el catálogo después del DDL.
' Crear uno por instrucción; execute admite DDL y DML sin pedir un recuento inexistente.
Private Sub EjecutarSQL(ByVal cn As Object, ByVal sql As String)
    Dim sentencia As Object
    sentencia = cn.createStatement()
    sentencia.execute(sql)
    ' El DDL pudo disponer el statement. Solo se omite el error de su cierre.
    On Error Resume Next
    sentencia.close()
    On Error GoTo 0
End Sub
